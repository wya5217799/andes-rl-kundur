%%{init: {"flowchart": {"defaultRenderer": "elk", "htmlLabels": true, "curve": "basis"}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
    F1["<b>F1 (root):</b> dH/dD action range<br/>70x / 47x too small<br/>(H0=10 baseline + tanh squash)"]:::root

    F2["<b>F2:</b> max-dF 3-4x too large<br/>(no governor + GENCLS<br/>+ ESS undersized)"]:::high
    F3["<b>F3:</b> final-dF 2.5x too large<br/>(F2 + load-step bias)"]:::high
    F4["<b>F4:</b> settling = infinite<br/>(F2 + actor jitter)"]:::high
    F5["<b>F5:</b> dH/dD trajectory<br/>not smooth<br/>(SAC stochastic actor)"]:::mid
    F6["<b>F6:</b> cum-rf is single-axis<br/>false positive<br/>(motivates 6-axis aggregation)"]:::meta

    M1["M1: 6-axis geometric-mean rule<br/>(any axis = 0 forces overall = 0)"]:::correction

    subgraph AX["Six axes of evaluation (w8515 ensemble scores)"]
        direction LR
        A1["Axis 1<br/>max-dF<br/>0.47"]:::axis
        A2["Axis 2<br/>final-dF<br/>0.36"]:::axis
        A3["Axis 3<br/>settling<br/>0.00"]:::axisFail
        A4["Axis 4<br/>range_H<br/>1.00"]:::axisOk
        A5["Axis 5<br/>range_D<br/>1.00"]:::axisOk
        A6["Axis 6<br/>smoothness<br/>0.95"]:::axisOk
    end

    F1 ==> F2
    F1 -.->|"directly limits"| A4
    F1 -.->|"directly limits"| A5

    F2 ==> F3
    F2 ==> F4
    F2 --> A1
    F2 --> A2
    F2 --> A3

    F3 --> A1
    F3 --> A2

    F5 ==> F4
    F5 --> A6

    F4 --> A3

    F6 -.->|"motivates"| M1
    M1 -.-> AX

