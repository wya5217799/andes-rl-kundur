+def test_physical_joint_obs_applies_frequency_adapter_once():
+    observation = {
+        i: np.arange(7, dtype=np.float32) + 10.0 * i
+        for i in range(4)
+    }
+    raw = runner._joint_obs(observation).reshape(4, 7)
+    converted = runner._physical_joint_obs(observation).reshape(4, 7)
+    assert np.allclose(converted[:, 0], raw[:, 0])
+    assert np.allclose(converted[:, 1:], raw[:, 1:] * np.float32(60.0 / 50.0))
